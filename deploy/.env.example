# Copy to /opt/srt/.env on the server.
IMAGE=ghcr.io/YOUR_GITHUB_USER/shree-ram-trading
PROD_DOMAIN=shreeramtrading.in
TEST_DOMAIN=test.shreeramtrading.in

# Image tags currently running. deploy.sh updates these – don't edit by hand.
PROD_TAG=latest
TEST_TAG=latest

PROD_DB_PASSWORD=generate-a-long-random-password
TEST_DB_PASSWORD=generate-a-different-long-random-password
