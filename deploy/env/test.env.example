# Test app settings -> copy to /opt/srt/env/test.env
# Use a DIFFERENT AUTH_SECRET from production so test logins never work on the live shop.
SITE_URL=https://test.shreeramtrading.in
AUTH_SECRET=generate-a-different-secret
ADMIN_EMAIL=owner@shreeramtrading.in
ADMIN_PASSWORD=

# Whole test site is behind this username/password
BASIC_AUTH_USER=srt
BASIC_AUTH_PASSWORD=choose-a-password
