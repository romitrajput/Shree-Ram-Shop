# Save in your repo as .github/workflows/unpack-zip.yml, then run it from the Actions tab.
# It unpacks the website zip into the repo, creates the first database migration,
# commits everything to main (and creates `develop`), then test-builds the site.
name: Unpack website zip

on:
  workflow_dispatch:
    inputs:
      zip:
        description: "Zip file path in the repo (leave blank to use the first .zip found)"
        required: false

permissions:
  contents: write

jobs:
  unpack:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: srt
          POSTGRES_PASSWORD: srt
          POSTGRES_DB: srt
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U srt" --health-interval 5s --health-retries 10
    env:
      DATABASE_URL: postgresql://srt:srt@localhost:5432/srt?schema=public
      AUTH_SECRET: unpack-check-only-secret-0123456789abcdef
      APP_ENV: test
    steps:
      - uses: actions/checkout@v4
        with:
          # Optional secret UNPACK_TOKEN (a token with "workflow" scope) lets this job also
          # install the CI/deploy workflows. Without it they're parked in setup/github-workflows.
          token: ${{ secrets.UNPACK_TOKEN || github.token }}

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Unpack the zip into the repository
        env:
          ZIP: ${{ inputs.zip }}
          HAS_WORKFLOW_TOKEN: ${{ secrets.UNPACK_TOKEN != '' }}
        run: |
          set -euo pipefail
          ZIP="${ZIP:-$(git ls-files '*.zip' | head -n1)}"
          if [ -z "$ZIP" ] || [ ! -f "$ZIP" ]; then echo "::error::No .zip file found in the repo"; exit 1; fi
          echo "Unpacking $ZIP"

          TMP=$(mktemp -d)
          unzip -q "$ZIP" -d "$TMP"
          # The zip contains one top folder (shree-ram-trading/); find the folder holding package.json.
          SRC=$(dirname "$(find "$TMP" -maxdepth 3 -name package.json -not -path '*/node_modules/*' | head -n1)")
          [ -f "$SRC/package.json" ] || { echo "::error::package.json not found inside the zip"; exit 1; }

          if [ "$HAS_WORKFLOW_TOKEN" != "true" ] && [ -d "$SRC/.github/workflows" ]; then
            # GitHub doesn't let the built-in token add workflow files.
            mkdir -p setup/github-workflows
            cp "$SRC"/.github/workflows/*.yml setup/github-workflows/
            rm -rf "$SRC/.github/workflows"
            echo "::warning::CI/deploy workflows saved in setup/github-workflows – move them to .github/workflows (see setup/README.md)"
            printf '%s\n' "Move ci.yml and deploy.yml from this folder into .github/workflows/ (GitHub web: open file → … → rename path)." > setup/README.md
          fi

          cp -a "$SRC"/. ./
          git rm -q --cached "$ZIP" 2>/dev/null || true
          rm -f "$ZIP"

      - name: Install packages (creates package-lock.json)
        run: npm install --no-audit --no-fund

      - name: Create the first database migration
        run: |
          # Generate the first migration once (later releases ship their own, e.g. *_feature_audit).
          if ! ls -d prisma/migrations/*_init >/dev/null 2>&1; then
            mkdir -p prisma/migrations/00000000000000_init
            npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script \
              > prisma/migrations/00000000000000_init/migration.sql
            [ -f prisma/migrations/migration_lock.toml ] || printf '# Please do not edit this file manually\nprovider = "postgresql"\n' > prisma/migrations/migration_lock.toml
          fi
          npx prisma migrate deploy

      - name: Commit and push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "Add Shree Ram Trading website from zip" || echo "Nothing to commit"
          git push
          # Create the develop branch used for the test environment, if it doesn't exist yet.
          git ls-remote --exit-code --heads origin develop >/dev/null || git push origin HEAD:refs/heads/develop

      - name: Check the website builds and the sample data loads
        run: |
          npm run db:seed
          npm run build
