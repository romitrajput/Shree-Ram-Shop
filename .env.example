# ---- Copy to .env for local development ----
# development | test | production  (read at runtime, so one Docker image serves both environments)
APP_ENV=development
SITE_URL=http://localhost:3000

DATABASE_URL=postgresql://srt:srt@localhost:5432/srt_dev?schema=public

# Long random string: `openssl rand -base64 48`
AUTH_SECRET=change-me-to-a-long-random-string

# Where uploaded product images / payment screenshots are stored (a Docker volume in servers)
UPLOAD_DIR=./uploads

# Test environment only: password-protect the whole site so customers never land on it
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# First owner account (used by `npm run create-admin` and the seed)
ADMIN_EMAIL=owner@shreeramtrading.in
ADMIN_PASSWORD=change-me

# Optional: Microsoft Clarity project id for heatmaps & session recordings
CLARITY_ID=
RATE_LIMIT_DISABLED=        # set to 1 only for automated test runs

# Netlify only: store uploaded photos in Netlify Blobs instead of UPLOAD_DIR.
# STORAGE=netlify
